# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Replace with your actual MongoDB connection URI)
MONGODB_URI=mongodb+srv://<DB_USER>:<DB_PASSWORD>@<CLUSTER>.mongodb.net/<DB_NAME>?retryWrites=true&w=majority

# Authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_secure_random_jwt_secret_min_32_characters
JWT_EXPIRE=24h

# External AI Service
AI_KEY=your_ai_service_api_key_here

# Security & CORS (Comma-separated allowed origins)
ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com
